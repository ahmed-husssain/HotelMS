# LuxuryStay Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
MONGODB_URI=mongodb://localhost:27017/luxurystay

# Authentication & Security
JWT_SECRET=luxurystay_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Safepay Payment Gateway (Sandbox)
SAFEPAY_API_KEY=sec_sandbox_your_api_key_here
SAFEPAY_SECRET_KEY=your_sandbox_secret_key_here
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_WEBHOOK_SECRET=your_sandbox_webhook_secret_here

# Temporary Room Hold Configuration
HOLD_DURATION_MINUTES=15

