          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Quote returns 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.test(\"13% Sindh tax calculated correctly\", () => {",
                  "  pm.expect(data.pricing.taxPercent).to.eql(13);",
                  "});",
                  "pm.test(\"30% advance deposit calculated correctly\", () => {",
                  "  pm.expect(data.pricing.advancePercent).to.eql(30);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Initiate 5-Minute Pessimistic Hold",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": \"301\",\n  \"checkInDate\": \"2026-12-24\",\n  \"checkOutDate\": \"2026-12-26\",\n  \"guestDetails\": {\n    \"name\": \"Postman VIP Guest\",\n    \"email\": \"postman.vip@stayza.com\",\n    \"phone\": \"+92 300 8899112\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bookings/hold",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "hold"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Hold created with 201\", () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set(\"activeBookingRef\", res.data.bookingReference);",
                  "pm.test(\"Hold duration is 5 minutes in future\", () => {",
                  "  const expires = new Date(res.data.holdExpiresAt).getTime();",
                  "  pm.expect(expires).to.be.above(Date.now());",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Lookup In-Stay Reservation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings/lookup?ref=TH-301-9041",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "lookup"
